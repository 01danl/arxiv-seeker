# --- LLM backend: ollama (default, local, free) | openai | anthropic ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For OpenAI-compatible proxies/gateways (e.g. vsellm, OpenRouter, LM Studio)
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: Semantic Scholar for citation counts ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Search / ranking tuning ---
DEFAULT_MAX_RESULTS=10
SIMILARITY_THRESHOLD=0.15
RERANK_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG tuning ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=4

# --- Cache ---

# --- Agent search tuning ---
AGENT_CANDIDATES_PER_QUERY=8
AGENT_FINAL_TOP_N=6
AGENT_MIN_PAPERS=2

TAVILY_API_KEY=
SEARCH_BACKEND=tavily
